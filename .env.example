# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Primary AI provider for high-speed generation
# Can specify GROQ_API_KEY, GROQ_API_KEY_2, GROQ_API_KEY_3... or GROQ_API_KEYS (comma-separated)
GROQ_API_KEY=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""
GROQ_API_KEY_4=""
GROQ_API_KEY_5=""
GROQ_API_KEY_6=""

# CEREBRAS_API_KEY: Fallback AI provider for high-speed llama inference
# Can specify CEREBRAS_API_KEY, CEREBRAS_API_KEY_2...
CEREBRAS_API_KEY=""
CEREBRAS_API_KEY_2=""
CEREBRAS_API_KEY_3=""
CEREBRAS_API_KEY_4=""

# MISTRAL_API_KEY: Fallback AI provider for Mistral models
# Can specify MISTRAL_API_KEY, MISTRAL_API_KEY_2...
MISTRAL_API_KEY=""
MISTRAL_API_KEY_2=""
MISTRAL_API_KEY_3=""
MISTRAL_API_KEY_4=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Token de acceso personal (PAT) de GitHub para persistencia en el repositorio.
GITHUB_TOKEN=""
GITHUB_REPO="tirianworld/Definitiva-Dracopedia"
GITHUB_BRANCH="main"

# FIREBASE_SERVICE_ACCOUNT_JSON: Clave privada de cuenta de servicio de Firebase (JSON en una sola línea)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Image Generation API Keys (Optional - for high-tier DM image generation)
OPENAI_API_KEY=""
TOGETHER_API_KEY=""
STABILITY_API_KEY=""
HF_TOKEN=""

# Discord Bot & Discord Activities Integration
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_GUILD_ID=""
